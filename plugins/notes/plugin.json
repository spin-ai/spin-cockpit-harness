{
  "id": "ai.cockpit.notes",
  "name": "Wiki",
  "version": "0.2.1",
  "apiVersion": 1,
  "engines": {
    "cockpit": ">=0.2.0"
  },
  "main": "main.mjs",
  "defaultEnabled": true,
  "activation": [
    "onStartup",
    "onView:notes"
  ],
  "permissions": [
    "state:read",
    "tasks:write",
    "ui:view",
    "agent:tools",
    "fs:vault"
  ],
  "contributes": {
    "views": [
      {
        "id": "notes",
        "title": "Wiki",
        "location": "main",
        "icon": "note"
      }
    ],
    "commands": [
      {
        "id": "wiki.open",
        "title": "打开 Wiki",
        "description": "打开原生 LLM Wiki"
      },
      {
        "id": "wiki.new",
        "title": "新建 Wiki 页面",
        "description": "创建一个 draft 页面"
      },
      {
        "id": "wiki.graph",
        "title": "打开 Wiki 图谱",
        "description": "查看 Source/Page 关系"
      },
      {
        "id": "wiki.openFolder",
        "title": "打开本地 Markdown 目录",
        "description": "打开并浏览本地 Markdown 目录，可直接编辑写回；也可导入为 Wiki Source"
      },
      {
        "id": "wiki.curate",
        "title": "整理 Wiki（统一大纲 / 补双向链接 / 重建索引）",
        "description": "把每个页面规范成「要点 / 原文摘录 / 相关」，同源页面互链，并重建 Wiki 索引"
      }
    ],
    "events": [
      "mission.finished"
    ]
  }
}
