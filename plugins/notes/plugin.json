{
  "id": "ai.cockpit.notes",
  "name": "Wiki",
  "version": "0.2.0",
  "apiVersion": 1,
  "engines": {
    "cockpit": ">=0.2.0"
  },
  "main": "main.mjs",
  "defaultEnabled": true,
  "activation": [
    "onStartup",
    "onView:notes"
  ],
  "permissions": [
    "state:read",
    "tasks:write",
    "ui:view",
    "agent:tools"
  ],
  "contributes": {
    "views": [
      {
        "id": "notes",
        "title": "Wiki",
        "location": "main",
        "icon": "note"
      }
    ],
    "commands": [
      {
        "id": "wiki.open",
        "title": "打开 Wiki",
        "description": "打开原生 LLM Wiki"
      },
      {
        "id": "wiki.new",
        "title": "新建 Wiki 页面",
        "description": "创建一个 draft 页面"
      },
      {
        "id": "wiki.graph",
        "title": "打开 Wiki 图谱",
        "description": "查看 Source/Page 关系"
      }
    ],
    "events": [
      "mission.finished"
    ]
  }
}
