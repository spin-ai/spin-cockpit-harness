{
  "name": "spin-cockpit-harness",
  "version": "0.2.0-alpha.2",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:electron": "electron .",
    "build": "vite build",
    "start": "electron .",
    "install:mac": "node scripts/install-mac.mjs",
    "dist": "node scripts/bundle-dsh.mjs && vite build && electron-builder && node scripts/install-mac.mjs",
    "pack": "node scripts/bundle-dsh.mjs && vite build && electron-builder --dir",
    "dist:mac": "node scripts/bundle-dsh.mjs --platform macos && vite build && electron-builder --mac dmg && node scripts/install-mac.mjs",
    "dist:win": "node scripts/bundle-dsh.mjs --platform win --arch x64 && vite build && electron-builder --win nsis --x64",
    "dist:linux": "node scripts/bundle-dsh.mjs --platform linux && vite build && electron-builder --linux AppImage",
    "dist:linux:x64": "node scripts/bundle-dsh.mjs --platform linux --arch x64 && vite build && electron-builder --linux AppImage --x64",
    "dist:linux:arm64": "node scripts/bundle-dsh.mjs --platform linux --arch arm64 && vite build && electron-builder --linux AppImage --arm64",
    "dist:system": "vite build && electron-builder",
    "pack:system": "vite build && electron-builder --dir",
    "bundle:dsh": "node scripts/bundle-dsh.mjs",
    "bundle:dsh:optional": "node scripts/bundle-dsh.mjs --optional",
    "smoke:dsh": "node scripts/smoke-dsh.mjs",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit",
    "verify:mission": "node scripts/verify-mission.mjs",
    "verify:plugins": "node scripts/verify-plugins.mjs",
    "verify:design": "node scripts/verify-design.mjs",
    "test:e2e:requirements": "node scripts/e2e-requirements.mjs",
    "test:e2e:requirements:list": "node scripts/e2e-requirements.mjs --list",
    "wiki:publish": "node scripts/publish-wiki.mjs",
    "docs:dev": "vite --config site/vite.config.ts",
    "docs:build": "vite build --config site/vite.config.ts",
    "docs:preview": "vite preview --config site/vite.config.ts",
    "dist:mac:slim": "node scripts/dist-slim.mjs",
    "dist:slim": "node scripts/dist-slim.mjs --dir"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "node-pty": "^1.1.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "grapesjs": "^0.23.9",
    "marked": "^18.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "build": {
    "appId": "ai.cockpit.harness",
    "productName": "Cockpit Harness",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.d.cts",
      "!**/*.md",
      "!**/*.markdown",
      "!**/{test,tests,__tests__,__mocks__,spec,specs,example,examples,bench,benchmark,benchmarks,docs,doc}/**",
      "!node_modules/sql.js/dist/*.zip",
      "!node_modules/sql.js/dist/*-debug.*",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/worker*",
      "!node_modules/sql.js/dist/*-inline*",
      "!node_modules/sql.js/dist/sql-wasm-browser*"
    ],
    "extraResources": [
      {
        "from": "resources/dsh",
        "to": "dsh",
        "filter": [
          "dsh",
          "dsh.exe",
          "dsh-rg",
          "dsh-rg.exe",
          "dsh-spawn-helper",
          "dsh-spawn-helper.exe",
          "manifest.json"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "electron/dsh-supervisor.patch.yml",
        "to": "dsh-supervisor.patch.yml"
      },
      {
        "from": "plugins/notes",
        "to": "plugins/notes"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm",
      "node_modules/node-pty/**",
      "electron/mcp-bridge.mjs",
      "electron/plugins/runtime.mjs",
      "electron/wiki-mcp-bridge.mjs"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/icon.png"
    },
    "icon": "resources/icon.png",
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "zh_CN"
    ]
  },
  "description": "Cockpit Harness — a local-first multi-agent cockpit: Chat → tasks, terminal panes, agent runs, review and confirmation.",
  "license": "MIT",
  "author": "spin-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spin-ai/spin-cockpit-harness.git"
  },
  "bugs": {
    "url": "https://github.com/spin-ai/spin-cockpit-harness/issues"
  },
  "homepage": "https://github.com/spin-ai/spin-cockpit-harness#readme",
  "keywords": [
    "electron",
    "agent",
    "multi-agent",
    "terminal",
    "xterm",
    "acp",
    "dsh",
    "cockpit",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "minimatch@9": "11.0.5",
    "minimatch@10": "11.0.5"
  }
}
